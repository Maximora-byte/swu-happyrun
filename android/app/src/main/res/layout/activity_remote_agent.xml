<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/remote_title" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/remote_intro" android:paddingTop="12dp" android:paddingBottom="16dp" />
        <EditText android:id="@+id/remote_endpoint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/remote_endpoint" android:inputType="textUri" android:maxLength="2048" android:singleLine="true" android:importantForAutofill="no" />
        <EditText android:id="@+id/remote_agent_id" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/remote_agent_id" android:inputType="textNoSuggestions" android:maxLength="36" android:singleLine="true" android:importantForAutofill="no" />
        <EditText android:id="@+id/remote_device_id" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/remote_device_id" android:inputType="textNoSuggestions" android:maxLength="36" android:singleLine="true" android:importantForAutofill="no" />
        <EditText android:id="@+id/remote_token" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/remote_token" android:inputType="textPassword" android:maxLength="4096" android:singleLine="true"
            android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants" />
        <Button android:id="@+id/remote_connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/remote_connect" />
        <Button android:id="@+id/remote_stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/remote_stop" android:enabled="false" />
        <TextView android:id="@+id/remote_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp" android:text="@string/remote_offline" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
